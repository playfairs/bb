project "bb" {
    version = file("./VERSION")
    license = file("./LICENSE")

    cxx_executable "bb" {
        sources = [
        "src/args.cpp",
        "src/filesize.cpp",
        "src/main.cpp",
        "src/pattern.cpp",
        "src/progress.cpp",
        "src/random.cpp",
        "src/sparse.cpp",
        "src/util.cpp",
        "src/verify.cpp",
        "src/writer.cpp"
        ]

        include_dirs = [
        "include"
        ]

        flags = [
        "-std=c++20"
        ]
        install = true
    }
}
